{
  "name": "routelock",
  "private": true,
  "version": "0.0.1",
  "description": "Transferable, escrow-backed on-chain service entitlements, gated by a refusing AI compliance engine.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
