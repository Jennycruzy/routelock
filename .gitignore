node_modules/
dist/
build/
out/
cache/
.next/
coverage/
*.tsbuildinfo

# Secrets — never commit. Carrier keys and deployer keys live only in .env.
.env
.env.*
!.env.example

# Foundry
packages/contracts/out/
packages/contracts/cache/
# Dry runs only. Real broadcast records stay tracked — they carry the tx hashes
# and timestamps that evidence the testnet-before-mainnet sequence.
packages/contracts/broadcast/**/dry-run/

# Carrier artifacts contain consignee PII and label PDFs — keep them off GitHub.
artifacts/carrier/
*.pdf

# The retirement ledger. Local durable spending state, not evidence: the proof
# of a retirement is its on-chain transaction and its public certificate.
**/data/retirements.jsonl

# Scoring-run checkpoints. Transient: they let an interrupted run resume
# without paying for the same rows twice, and are removed on a clean finish.
bench/data/.checkpoint-*.jsonl

.DS_Store

# Foundry libraries are fetched on install (see packages/contracts prepare
# script) rather than vendored, so the repo contains only RouteLock's own code.
packages/contracts/lib/

# The inference spend ledgers — the operator's, and the served API's separate
# one. Local operational state, not evidence.
**/data/inference-calls.jsonl
**/data/served-inference.jsonl
**/data/compute-inference-calls.jsonl
**/data/compute-inference-calls-*.jsonl
