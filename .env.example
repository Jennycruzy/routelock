# Copy to .env and fill in. .env is gitignored and must stay that way.
# chmod 600 .env — it holds a signing key.

# ---------------------------------------------------------------------------
# Role addresses
# ---------------------------------------------------------------------------
# ADMIN      registers issuers, pauses them, wires contracts, revokes roles.
# ORACLE     backend signer. Writes carrier-sourced facts: label, pickup,
#            delivery. Releases escrow. This is the key that moves money.
# COMPLIANCE records decision hashes and opens/closes the activation gate.
#            Moves no money — SettlementEscrow rejects COMPLIANCE_ROLE outright,
#            and the deploy script refuses to proceed if this address holds any
#            role on the escrow.
#
# ORACLE and COMPLIANCE must be DIFFERENT addresses. Setting them equal gives
# the compliance service authority over funds through the oracle role, which
# voids the guarantee the whole design rests on. Deploy.s.sol asserts this and
# aborts with WiringAssertionFailed("escrow.compliance.oracle").
ROUTELOCK_ADMIN=0x
ROUTELOCK_ORACLE=0x
ROUTELOCK_COMPLIANCE=0x

# Compliance signer, in plaintext because the compliance cron runs unattended
# and cannot answer a keystore password prompt. Keep this key disposable and
# used for nothing else: its only authority is recording decisions, and ADMIN
# can revoke it without a redeploy.
COMPLIANCE_PRIVATE_KEY=0x

# The deployer and oracle keys are NOT stored here. They live in the Foundry
# keystore, encrypted, and are used interactively:
#   cast wallet import routelock-deployer --interactive
#   forge script ... --account routelock-deployer

# ---------------------------------------------------------------------------
# RPCs — defaults match packages/chain/src/chains.ts
# ---------------------------------------------------------------------------
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

# ---------------------------------------------------------------------------
# Carrier — environment pairing is enforced at boot (packages/chain/src/chains.ts)
# ---------------------------------------------------------------------------
# testnet chains REQUIRE an sb_sandbox… key; mainnet REQUIRES sb_prod….
# A mismatch, an absent key, or an unrecognised prefix all throw at process
# start. There is deliberately no mock-carrier fallback.
SHIPBUBBLE_API_KEY=

# ---------------------------------------------------------------------------
# Compliance engine inference credential
# ---------------------------------------------------------------------------
# The engine is the one component that cannot be written against anything but a
# real model. There is no offline or canned-response mode, deliberately: a
# compliance engine that cannot perform real inference would be exactly the kind
# of simulated feature the build rules forbid.
#
# Set the key for whichever provider is in use. The engine reads the provider
# from ROUTELOCK_LLM_PROVIDER and refuses to boot if the matching key is absent.
ROUTELOCK_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model id. Pinned rather than defaulted so a benchmark result always names the
# model that produced it.
ROUTELOCK_LLM_MODEL=claude-sonnet-5
