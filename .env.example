# Copy to .env and fill in. .env is gitignored and must stay that way.
# chmod 600 .env — it holds a signing key.

# ---------------------------------------------------------------------------
# Role addresses
# ---------------------------------------------------------------------------
# ADMIN      registers issuers, pauses them, wires contracts, revokes roles.
# ORACLE     backend signer. Writes carrier-sourced facts: label, pickup,
#            delivery. Releases escrow. This is the key that moves money.
# COMPLIANCE records decision hashes and opens/closes the activation gate.
#            Moves no money — SettlementEscrow rejects COMPLIANCE_ROLE outright,
#            and the deploy script refuses to proceed if this address holds any
#            role on the escrow.
#
# These three must be distinct, and Deploy.s.sol now enforces it BEFORE it
# broadcasts anything — `RolesNotSeparated`, checked as a precondition rather
# than discovered afterwards from a half-built deployment.
#
#   oracle != compliance   every chain. Equal addresses give the compliance
#                          service authority over funds through ORACLE_ROLE,
#                          which voids the guarantee the whole design rests on.
#                          The escrow's refusal to grant COMPLIANCE_ROLE defends
#                          against granting the wrong role; nothing but this
#                          defends against reusing the address.
#   admin  != compliance   every chain, same reasoning from the other side.
#   admin  != oracle       MAINNET ONLY (196, 677). The oracle signs unattended
#                          from a server, so sharing its key with ADMIN_ROLE
#                          means a box compromise also reaches role
#                          administration. Allowed on testnet as a deliberate
#                          shortcut — which is what the live 1952 deployment
#                          uses today, and what a mainnet deploy will refuse.
ROUTELOCK_ADMIN=0x
# Provider wallet registered on every fresh factory deployment. This is the
# wallet that creates offers and controls its own offer collateral.
ROUTELOCK_ISSUER=0x
ROUTELOCK_ORACLE=0x
ROUTELOCK_COMPLIANCE=0x

# Compliance signer, in plaintext because the compliance cron runs unattended
# and cannot answer a keystore password prompt. Keep this key disposable and
# used for nothing else: its only authority is recording decisions, and ADMIN
# can revoke it without a redeploy.
COMPLIANCE_PRIVATE_KEY=0x

# Optional unattended oracle relayer used only after the consumer's provider
# proof is returned. Must resolve to ROUTELOCK_ORACLE in the selected
# deployment. It is the only API identity permitted to attach provider evidence
# and release the corresponding escrow; it never signs a consumer payment.
# Leave this empty when using the encrypted Foundry keystore below.
ROUTELOCK_ORACLE_PRIVATE_KEY=0x

# The deployer and oracle keys are NOT stored here. They live in the Foundry
# keystore, encrypted, and are used interactively:
#   cast wallet import routelock-deployer --interactive
#   forge script ... --account routelock-deployer

# ---------------------------------------------------------------------------
# RPCs — defaults match packages/chain/src/chains.ts
# ---------------------------------------------------------------------------
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

# ---------------------------------------------------------------------------
# Carrier — environment pairing is enforced at boot (packages/chain/src/chains.ts)
# ---------------------------------------------------------------------------
# testnet chains REQUIRE an sb_sandbox… key; mainnet REQUIRES sb_prod….
# A mismatch, an absent key, or an unrecognised prefix all throw at process
# start. There is deliberately no mock-carrier fallback.
SHIPBUBBLE_API_KEY=

# ---------------------------------------------------------------------------
# Carbon retirement — Carbonmark
# ---------------------------------------------------------------------------
# Same pairing rule as the carrier: testnet chains REQUIRE a cm_api_sandbox…
# key. The production prefix is not yet known — production access has not been
# granted — so an unrecognised prefix throws rather than being guessed at.
#
# Note there is no separate sandbox host: api.sandbox.carbonmark.com does not
# resolve, and both environments answer on api.carbonmark.com. The key is the
# only thing that distinguishes them, which is why the prefix check matters more
# here than it does for the carrier.
#
# Verifying this key means calling /orders, which returns 401 when the key is
# bad. Do NOT check it against /prices — that endpoint is fully public and
# returns 200 with no key at all. See docs/carbonmark-verification.md.
CARBONMARK_API_KEY=

# ---------------------------------------------------------------------------
# Compliance engine inference credential
# ---------------------------------------------------------------------------
# The engine is the one component that cannot be written against anything but a
# real model. There is no offline or canned-response mode, deliberately: a
# compliance engine that cannot perform real inference would be exactly the kind
# of simulated feature the build rules forbid.
#
# Set the key for whichever provider is in use. The engine reads the provider
# from ROUTELOCK_LLM_PROVIDER and refuses to boot if the matching key is absent.
ROUTELOCK_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model id. Pinned rather than defaulted so a benchmark result always names the
# model that produced it.
ROUTELOCK_LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Compute lane — Akash Console API
# ---------------------------------------------------------------------------
# BOT Chain is the compute lane. These values are deliberately required by
# compute:e2e; there is no default SDL, image, workload, provider, bid, or
# ingress URL in the repository.
AKASH_CONSOLE_API_URL=https://console-api.akash.network
AKASH_API_KEY=
AKASH_SDL_PATH=
AKASH_WORKLOAD_DESCRIPTION=
AKASH_SERVICE_NAME=
AKASH_DEPLOYER_JURISDICTION=
AKASH_LAWFUL_USE_CONFIRMATION=
AKASH_ACCEPTABLE_USE_POLICY_URL=
AKASH_DEPOSIT_USD=
# Optional exact provider; omit to choose the cheapest open live bid.
AKASH_PROVIDER_ADDRESS=
# Polling values are operator choices, not provider fixtures.
AKASH_BID_POLL_MS=
AKASH_BID_TIMEOUT_MS=
AKASH_READY_POLL_MS=
AKASH_READY_TIMEOUT_MS=

# BOT-chain entitlement economics and class identity. All are required for a
# compute run; use a fresh class label each time rather than reusing a class.
ROUTELOCK_COMPUTE_CLASS_LABEL=
ROUTELOCK_COMPUTE_PRICE=
ROUTELOCK_COMPUTE_COLLATERAL=
ROUTELOCK_COMPUTE_PAYOUT=
ROUTELOCK_COMPUTE_MAX_SUPPLY=
ROUTELOCK_COMPUTE_VALID_UNTIL=

# Compute inference cap. The cap is enforced before the live Anthropic call
# and the call is appended to the shared ledger after the API reports usage.
ROUTELOCK_COMPUTE_MAX_MODEL_CALLS=
ROUTELOCK_COMPUTE_MODEL_BUDGET_USD=
# Set after a completed mainnet BOT compute e2e. The API will not report the
# compute lane as active without this HTTPS ingress proof.
ROUTELOCK_COMPUTE_PROOF_URL=

# Interactive Foundry keystore account names. The passwords are never put in
# .env or on the command line.
ROUTELOCK_KEYSTORE_ACCOUNT=routelock-deployer
ROUTELOCK_ORACLE_KEYSTORE_ACCOUNT=routelock-oracle
